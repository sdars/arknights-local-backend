# MySQL 8.4 (docker compose)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=arknights
MYSQL_USER=ark
MYSQL_PASSWORD=change-me-ark

# adb 设备
ADB_SERIAL=8.162.0.198:30135

# 注入客户端的账号
ARK_PHONE=13800138000
ARK_TOKEN=lab_manual_token
ARK_UID=10000000

# 后端对客户端暴露的地址（通过 adb reverse，设备侧 127.0.0.1 即本机）
SERVER_URL=http://127.0.0.1:8443
SERVER_HTTP_PORT=8443
SERVER_HTTPS_PORT=36650

# mitmproxy
MITM_PORT=8080

